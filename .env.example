# PAC environment variables — placeholders only, never commit real values.
# Set these in Netlify site environment variables (not in .env files for production).
#
# SECURITY: PAC_ADMIN_TOKEN must never appear in Slack messages, Slack links,
# URLs, browser code, localStorage, logs, or frontend env vars.
# Do NOT use VITE_, NEXT_PUBLIC_, PUBLIC_, or similar public prefixes for secrets.

PAC_ADMIN_TOKEN=
PAC_SLACK_BOT_TOKEN=
PAC_SLACK_SIGNING_SECRET=
PAC_HR_CHANNEL_ID=
NETLIFY_BLOBS_TOKEN=
NETLIFY_SITE_ID=

# Development only — skip Slack signature verification (never set true in production)
PAC_SKIP_SIG_VERIFY=
