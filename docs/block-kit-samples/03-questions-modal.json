      "block_id": "pac_block_q_3",
      "label": {
        "type": "plain_text",
        "text": "4. Is the performance decline consistent and ongoing (not a single incident)?"
      },
      "hint": {
        "type": "plain_text",
        "text": "A pattern over time is stronger than one bad week. Consider whether something changed."
