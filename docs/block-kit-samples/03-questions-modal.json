            },
            "value": "unknown"
          }
        ]
      }
    },
    {
      "type": "input",
      "block_id": "pac_block_q_2",
      "label": {
        "type": "plain_text",
        "text": "3. Has the employee been given a clear opportunity to respond to concerns?"
      },
      "hint": {
        "type": "plain_text",
        "text": "This means a real conversation, not just an email. The employee should be able to explain context."
      },
      "element": {
        "type": "radio_buttons",
        "action_id": "pac_q_answer_2",
        "options": [
          {
